# =============================================================================
# Puns
#
# Values that are already known are filled in. Anything left blank is a secret
# or an account detail that only you can supply.
#
# The web app reads only VITE_ prefixed variables, and only those reach the
# browser. Never put a key behind a VITE_ name.
# =============================================================================


# -----------------------------------------------------------------------------
# Chain
# -----------------------------------------------------------------------------
# Robinhood Chain mainnet, an Arbitrum Orbit rollup that settles in ETH.
# The chain id and explorer are fixed in src/lib/chain.ts rather than here:
# they are properties of the network, not choices, and a wrong value in an
# environment variable would be a silent way to point the app at nothing.

# The public endpoint is unreliable: roughly 30% of calls fail under light load,
# and it has been fully offline for stretches. Use a private endpoint.
RPC_MAINNET=https://rpc.mainnet.chain.robinhood.com
RPC_TESTNET=https://rpc.testnet.chain.robinhood.com
RPC_LOCAL=http://127.0.0.1:8545

# FILL THIS IN. Your private Alchemy endpoint. Foundry also accepts its TLS,
# which the public endpoint intermittently fails.
RPC_MAINNET_ALCHEMY=

# What the browser uses. Point it at the private endpoint too.
VITE_RPC_MAINNET=
VITE_RPC_FALLBACKS=https://rpc.mainnet.chain.robinhood.com


# -----------------------------------------------------------------------------
# Contracts
# -----------------------------------------------------------------------------
# Ours, deployed and verified 2026-09-04.
PUNS_PASS_ADDRESS=0x6d050DB66e3317C810Cfe52AA8A0b52b6fA28231
VITE_PUNS_PASS_ADDRESS=0x6d050DB66e3317C810Cfe52AA8A0b52b6fA28231

# The launch core the app reads and routes trades through.
LAUNCH_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
VITE_LAUNCH_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Supporting contracts. Needed for fee claims and buyback vesting.
FEE_ESCROW_ADDRESS=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
BUYBACK_VAULT_ADDRESS=0x42df2a798f82289E177311362e8f5ccC45c1219c
MEME_HOOK_ADDRESS=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044


# -----------------------------------------------------------------------------
# Roles
# -----------------------------------------------------------------------------
PUNS_OWNER=0xE1D78A6f24380cF7caDBB163ce2a598821631B67
PUNS_TREASURY=0xf0099f6D992DfbBF87343317D929AE98b9472C13
PUNS_TREASURY_ADDRESS=0xf0099f6D992DfbBF87343317D929AE98b9472C13

# Currently the same as the owner, by choice. A dedicated wallet here would mean
# the scheduled re-peg job never holds the owner key.
PUNS_PRICER=0xE1D78A6f24380cF7caDBB163ce2a598821631B67


# -----------------------------------------------------------------------------
# Puns Pass terms
# -----------------------------------------------------------------------------
PUNS_PASS_BASE_URI=https://punsfun.app/pass/

# Creator: lifetime, tracking $10.
PUNS_PASS_CREATOR_PRICE=4000000000000000
PUNS_PASS_CREATOR_DURATION=0
PUNS_PASS_CREATOR_USD_CENTS=1000

# Pro: 30 days, tracking $8.
PUNS_PASS_PRO_PRICE=3200000000000000
PUNS_PASS_PRO_DURATION=2592000
PUNS_PASS_PRO_USD_CENTS=800


# -----------------------------------------------------------------------------
# Wallet
# -----------------------------------------------------------------------------
# FILL THIS IN. Required. There is no fallback: without it the Connect button
# is disabled rather than quietly opening whatever wallet the browser has.
VITE_REOWN_PROJECT_ID=


# -----------------------------------------------------------------------------
# Media
# -----------------------------------------------------------------------------
# FILL THIS IN. Used to pin token images when someone creates a launch.
PINATA_JWT=
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/


# -----------------------------------------------------------------------------
# Chain reads
# -----------------------------------------------------------------------------
# Used only when the indexer is unreachable and the browser scans logs itself.
# That path needs a provider permitting a wide getLogs range; the common free
# tiers cap it at a handful of blocks and will return nothing.
VITE_INDEXER_START_BLOCK=
VITE_LOG_RANGE=180000
VITE_RPC_LOGS=
VITE_LOG_CHUNK=40000


# -----------------------------------------------------------------------------
# Re-peg job (tools/repeg.mjs)
# -----------------------------------------------------------------------------
REPEG_THRESHOLD_BPS=300

# FILL THIS IN if the job runs on a schedule. Should be the pricer key, and the
# pricer should not be the owner.
PRICER_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Local RPC proxy (tools/rpc-proxy.mjs)
# -----------------------------------------------------------------------------
RPC_UPSTREAM=https://rpc.mainnet.chain.robinhood.com
RPC_PROXY_PORT=8546
RPC_RETRIES=5


# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# FILL THIS IN only when deploying. Local machine only, never committed.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Indexer (Netlify scheduled function + Netlify Blobs)
# ---------------------------------------------------------------------------
# Server side. Set these in Netlify, not in the browser.
# Leave INDEXER_RPC_URL blank to reuse RPC_MAINNET_ALCHEMY.
INDEXER_RPC_URL=
INDEXER_LOG_CHUNK=9
INDEXER_REQUESTS_PER_RUN=90
INDEXER_CONCURRENCY=6

# Where the browser asks for the list. Defaults to the function on this site.
VITE_INDEXER_URL=
